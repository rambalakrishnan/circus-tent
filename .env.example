# Copy to .env and fill in. .env is gitignored and chmod 600.
# In production, export these directly in the process environment instead.

# --- Model providers (OpenCode Go subscription) ---
# Text-healing model: OpenAI Responses-API format
MUSE_API_KEY=
MUSE_API_BASE=https://opencode.ai/zen/go/v1/responses
# Vision fallback model: OpenAI chat-completions format
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://opencode.ai/zen/go/v1/chat/completions

# --- Challenge resolution ---
CAPSOLVER_API_KEY=

# --- API bearer key for REST + MCP callers (constant-time compare) ---
# Generate: openssl rand -hex 32
AUTOMATION_WRAPPER_API_KEY=

# --- Account registry references (see config/accounts.yaml) ---
# Names here must match *_env entries in accounts.yaml. Values never live in git.
NEOGOV_USERNAME=
NEOGOV_PASSWORD=
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
WORKDAY_ACME_USERNAME=
WORKDAY_ACME_PASSWORD=

# --- Optional runtime overrides ---
# PROFILES_DIR=~/.automation-wrapper
# LOG_LEVEL=INFO
# HOST=127.0.0.1
# PORT=8000
